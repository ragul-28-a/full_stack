# React client configuration. Use the Supabase project URL and anon/publishable key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Leave empty for local Vite proxying to Django on port 8000.
# Set to the public Django API origin in Vercel, for example https://api.example.com
VITE_API_BASE_URL=

# Django backend environment. Configure these in the Django host as well.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional, for the PostgreSQL MCP connection only. Never commit the real value.
SUPABASE_DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
